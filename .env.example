# Copy to .env for local development. Never commit .env.

# Postgres (Docker Compose). Host port is 5434: Postgres.app owns 5432 and another local project uses 5433.
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot_dev
POSTGRES_DB=jobpilot
POSTGRES_PORT=5434
DATABASE_URL=postgresql://jobpilot:jobpilot_dev@localhost:5434/jobpilot
# Password for the seeded user dev@jobpilot.test (pnpm db:seed). Min 12 characters.
SEED_USER_PASSWORD=jobpilot-dev-password
# Integration tests create and migrate this database themselves. Must end in _test.
TEST_DATABASE_URL=postgresql://jobpilot:jobpilot_dev@localhost:5434/jobpilot_test

# Redis (Docker Compose)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# S3-compatible storage (MinIO in Docker Compose). The key pair below is the
# MinIO root user; stage 4 creates the bucket and a narrower key.
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=jobpilot
S3_SECRET_ACCESS_KEY=jobpilot_dev_secret
S3_BUCKET=jobpilot
S3_FORCE_PATH_STYLE=true
# Create the bucket on start (local only; in AWS it is created with the infrastructure).
S3_CREATE_BUCKET=true
# Tests use their own bucket in the same MinIO.
TEST_S3_BUCKET=jobpilot-test

# API (apps/api)
NODE_ENV=development
API_PORT=3001
LOG_LEVEL=info

# Worker (apps/worker)
# Fetches are scheduled by the Kubernetes CronJob (every 6 h, within Remotive's ~4 requests/day).
# Locally, run `pnpm fetch:now` when you want fresh listings.
SCORE_CONCURRENCY=10
# Bull Board (failed jobs, retries) on http://127.0.0.1:3002. 0 turns it off.
BULL_BOARD_PORT=3002
# Worker tests use a separate Redis database number so they never touch dev queues.
TEST_REDIS_URL=redis://localhost:6379/1
# Headless Chrome for CV PDFs. In Docker this is /usr/bin/chromium with CHROME_NO_SANDBOX=true.
CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# Web (apps/web): where the Next.js server reaches the API. Browsers only ever talk to the web app.
API_INTERNAL_URL=http://localhost:3001
