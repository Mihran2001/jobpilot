# Copy to .env for local development. Never commit .env.

# Postgres (Docker Compose). Host port is 5434: Postgres.app owns 5432 and another local project uses 5433.
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot_dev
POSTGRES_DB=jobpilot
POSTGRES_PORT=5434
DATABASE_URL=postgresql://jobpilot:jobpilot_dev@localhost:5434/jobpilot

# Redis (Docker Compose)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
