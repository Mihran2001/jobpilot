# Non-secret settings for the local cluster. Secrets: secrets.env (gitignored).
NODE_ENV=production
LOG_LEVEL=info
API_PORT=3001
API_INTERNAL_URL=http://api:3001
# The gateway and web pods are on private cluster addresses.
TRUST_PROXY=uniquelocal
SESSION_TTL_DAYS=7
AUTH_RATE_LIMIT_PER_MINUTE=5
# Postgres, Redis and MinIO stay in Docker Compose on your Mac.
REDIS_URL=redis://host.docker.internal:6379
S3_ENDPOINT=http://host.docker.internal:9000
# Presigned URLs are opened by your browser, which reaches MinIO on localhost.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=jobpilot
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=false
WORKER_HEALTH_PORT=3003
BULL_BOARD_PORT=0
SCORE_CONCURRENCY=10
CV_CONCURRENCY=1
