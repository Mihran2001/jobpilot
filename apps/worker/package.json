    "bullmq": "6.3.16",
    "express": "5.2.1",
    "ioredis": "6.0.0",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
